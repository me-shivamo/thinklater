# Paste into Railway → your service → Variables → "Raw Editor".
#
# Only the two secrets at the top actually need editing; the rest are the
# values this deploy wants and are safe to paste as-is.

SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=123456:ABCdef...

# "auto" = Sarvam Dub — real speaker voice cloning, 2-5 min server-side. That
# wait is Sarvam's, not this container's, so it costs almost no CPU here.
# "manual" runs translate + TTS + atempo locally and is the slower choice on a
# small instance.
CLIPCRAFT_DUB_ENGINE=auto

# `vijay` reads tighter than the `shubh` default on single-word inserts.
CLIPCRAFT_TTS_SPEAKER=vijay

# Telegram allows exactly ONE getUpdates poller per token. Set this to 0 if you
# keep running `python bot.py` on your laptop, or the two will fight over the
# token and one will crash-loop on 409 Conflict.
CLIPCRAFT_RUN_BOT=1

PYTHONUNBUFFERED=1
