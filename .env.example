# ── Required ────────────────────────────────────────────────────────────────
# All five Sarvam APIs (Saaras STT, sarvam-105b, Translate, Bulbul TTS, Dub).
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for bot.py. The CLI, the web editor and the API run without it.
TELEGRAM_BOT_TOKEN=123456:ABCdef...

# ── Optional — everything below has a working default ───────────────────────
# See clipcraft/config.py for the values these feed.

# auto   -> Sarvam Dub: real speaker voice cloning, 2-5 min server-side job,
#           falls back to local TTS if it fails
# manual -> Translate + Bulbul TTS locally: ~20s, no cloning
# sarvam -> Sarvam Dub only, fail loudly
#CLIPCRAFT_DUB_ENGINE=auto

# Bulbul voice for `insert` and for manual dubs. `vijay` reads tighter than the
# `shubh` default on single words. Full list: config.TTS_SPEAKERS.
#CLIPCRAFT_TTS_SPEAKER=shubh

# saaras:v3 | saaras:v4
#CLIPCRAFT_STT_MODEL=saaras:v3

# Planning and locating are extraction tasks, not reasoning ones — "low" roughly
# halves LLM latency with no measurable quality loss.
#CLIPCRAFT_REASONING_EFFORT=low

# 0 turns off the slow-motion window around a video insert and freezes a frame
# instead. Freezing reads as a glitch, which is why it isn't the default.
#CLIPCRAFT_INSERT_MOTION=1

# ── Container only (deploy/start.sh, not read by config.py) ─────────────────
# 0 keeps the container's Telegram bot switched off. Telegram allows exactly ONE
# getUpdates poller per token, so set this if you also run bot.py locally.
#CLIPCRAFT_RUN_BOT=1

# Injected by Railway/Render. start.sh falls back to 8000 locally — don't
# hardcode it in a deploy.
#PORT=8000
