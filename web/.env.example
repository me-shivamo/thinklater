# Origin of the Python FastAPI engine (server.py). The Vite dev server proxies
# /api to this. Leave default for local dev.
VITE_BACKEND_ORIGIN=http://localhost:8000

# "0" = talk to the live backend via /api. This is the default and what you
#       want for anything real — a missing/empty value means live.
# "1" = opt in to static fixtures so the UI runs with no backend and no API
#       spend. A "Demo mode" badge appears in the header whenever this is on.
#
# Vite inlines this at BUILD time, so `npm run build` bakes whatever is set
# here into dist/ permanently. Check the badge is absent on the built bundle,
# not just in dev.
VITE_USE_FIXTURES=0
